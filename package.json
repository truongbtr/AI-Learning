{
  "name": "mtct",
  "private": true,
  "version": "0.1.1",
  "description": "Hoc cung Mai Thy & Chi Thanh - family learning platform (EDISON_LEARNING)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm art:sync && turbo run dev",
    "build": "pnpm art:sync && turbo run build",
    "release:bump": "node scripts/release-version.mjs bump",
    "release:check": "node scripts/release-version.mjs check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "turbo run test",
    "e2e": "pnpm --filter @mtct/web e2e",
    "e2e:all": "pnpm --filter @mtct/web exec playwright test",
    "db:generate": "pnpm --filter @mtct/db generate",
    "db:migrate": "pnpm --filter @mtct/db migrate",
    "db:deploy": "pnpm --filter @mtct/db deploy",
    "db:seed": "pnpm --filter @mtct/db seed",
    "db:seed:dev": "pnpm --filter @mtct/db seed:dev",
    "db:studio": "pnpm --filter @mtct/db studio",
    "content:validate": "pnpm --filter @mtct/content run validate",
    "content:import": "pnpm --filter @mtct/db run content:import",
    "content:stats": "pnpm --filter @mtct/db run content:stats",
    "inbox:pull": "pnpm --filter @mtct/inbox run pull",
    "inbox:validate": "pnpm --filter @mtct/inbox run validate",
    "inbox:push": "pnpm --filter @mtct/inbox run push",
    "skills:validate": "pnpm --filter @mtct/content validate:skills",
    "decay:run": "pnpm --filter @mtct/worker decay:run",
    "plan:run": "pnpm --filter @mtct/worker plan:run",
    "intake:run": "pnpm --filter @mtct/worker intake:run",
    "content:export": "pnpm --filter @mtct/db run content:export",
    "content:import-intake": "pnpm --filter @mtct/db run content:import-intake",
    "eval:intake": "pnpm --filter @mtct/db run eval:intake",
    "db:school-year": "pnpm --filter @mtct/db run school-year",
    "db:clean-test-students": "pnpm --filter @mtct/db run clean-test-students",
    "db:clean-test-parents": "pnpm --filter @mtct/db run clean-test-parents",
    "db:reset-learning": "pnpm --filter @mtct/db run reset-learning",
    "db:export-student": "pnpm --filter @mtct/db run export-student",
    "db:delete-student": "pnpm --filter @mtct/db run delete-student",
    "db:assess": "pnpm --filter @mtct/db run assess",
    "db:usage": "pnpm --filter @mtct/db run usage",
    "db:trial": "pnpm --filter @mtct/db run trial",
    "ops:export": "pnpm --filter @mtct/db run ops:export",
    "ops:apply": "pnpm --filter @mtct/db run ops:apply",
    "tts:voices": "pnpm --filter @mtct/db run tts:voices",
    "tts:smoke": "pnpm --filter @mtct/db run tts:smoke",
    "art:build": "node scripts/art-build/build.mjs",
    "art:icons": "node scripts/art-icons.mjs",
    "art:check": "node scripts/art-check.mjs",
    "art:sync": "node scripts/art-sync.mjs",
    "art:emoji": "node scripts/emoji-vendor.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@iconify-json/noto": "^1.2.7",
    "turbo": "^2.10.0",
    "typescript": "^5.9.0"
  }
}
