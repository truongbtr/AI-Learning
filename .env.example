# ===== Hoc cung Mai Thy & Chi Thanh — bien moi truong =====
# Sao chep thanh .env va dien gia tri that. KHONG commit .env.
# Khong co khoa API LLM nao trong he thong (ADR-10).

# --- PostgreSQL (docker/compose.yml tao container "postgres" voi cac gia tri nay) ---
POSTGRES_USER=mtct
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=mtct
# Cong Postgres mo ra may host (doi neu 5432 da co ung dung khac dung)
POSTGRES_PORT=5432
# Ket noi tu may host (pnpm dev, prisma studio). Trong container, compose tu doi host thanh "postgres".
DATABASE_URL=postgresql://mtct:change-me-postgres@localhost:5432/mtct

# --- Auth.js ---
# Tao bang PowerShell:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=change-me-32-bytes-base64
# URL cong khai cua web (qua Cloudflare Tunnel thi doi thanh https://<domain>)
AUTH_URL=http://localhost:5000
AUTH_TRUST_HOST=true

# --- Tai khoan admin tao san (chi seed khi DB chua co ADMIN; bat buoc doi mat khau lan dau) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=ba@example.com
ADMIN_PASSWORD=change-me-strong-password-10+

# --- Nam hoc: ngay bat dau tuan 1 (chu du an chot 12/09/2026; sua lai o /parent/school, docs/11 §5) ---
SCHOOL_YEAR_START=2026-08-24

# --- File & hang cho AI ---
FILE_ROOT=/data/files
INBOX_ROOT=./inbox
# Du lieu van hanh (docs/14): noi pnpm ops:export ghi ra, va noi Claude chat doc.
# De trong = ./ops o goc repo. Trong container worker la /data/ops (bind mount ../ops).
OPS_ROOT=./ops

# --- TTS (ADR-6, ADR-11 + bo sung Azure): giong DUNG SAN, KHONG nhan ban giong tre ---
# azure     = MAC DINH (bac F0 mien phi ~500k ky tu/thang). Khong co khoa -> Web Speech, app van chay.
# vbee      = tuy chon (nha cung cap Viet Nam). google | webspeech = tuy chon.
TTS_PROVIDER=azure
# Khoa tai nguyen Speech tren Azure. DE TRONG trong file mau nay.
TTS_API_KEY=
# Vbee: App-Id cua ung dung trong bang dieu khien Vbee
TTS_APP_ID=
# Azure: vung cua tai nguyen Speech. Vbee/Google: khong can.
TTS_REGION=eastasia
# De trong = giong da chot (nghe thu 11/09/2026). Liet ke giong that: pnpm tts:voices
# azure  vi: vi-VN-HoaiMyNeural  en: en-US-AnaNeural
# vbee   vi: hn_female_ngochuyen_full_48k-fhg (kiem lai bang pnpm tts:voices)
# google vi: vi-VN-Neural2-A     en: en-US-Neural2-F
TTS_VOICE_VI=
TTS_VOICE_EN=
# CHI ap cho TIENG ANH (SSML <prosody rate>). Tieng Viet doc nguyen toc do goc - da chot, dung them.
# Nghe thu mot cau: pnpm tts:smoke "Nghe roi chon o dung nhe!"
TTS_RATE=-10%

# --- Token noi bo: worker goi POST /api/evidence, va app Claude tren dien thoai goi /api/internal/* ---
# BAT BUOC tu pha 8b (docs/13 §7): chua co token thi /api/internal/* tra 503 va chat khong day duoc
# anh bai vo vao he thong. Tao: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Nhanh /api/internal/* KHONG dung phien dang nhap; token nay la khoa duy nhat.
INTERNAL_API_TOKEN=

# --- Cloudflare Access: lop khoa thu hai truoc /parent va /admin (docs/VAN-HANH.md 4.3) ---
# De trong ca hai = tat kiem tra (chay trong LAN, hoac khi dev). Chi bat khi DA tao Access app.
# Zero Trust > Settings > Custom Pages: <ten-team>.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag cua Access app
CF_ACCESS_AUD=

# --- Cloudflare Tunnel (pha 8) ---
# Token cua tunnel trong Zero Trust > Networks > Tunnels. Dat vao day roi:
#   docker compose --env-file .env -f docker/compose.yml --profile tunnel up -d cloudflared
TUNNEL_TOKEN=

# --- Tai khoan ADMIN rieng de chay bo e2e (pha 8 viec 0.5) ---
# KHONG dung mat khau admin that. Chu du an tao trong /admin/users:
#   vai tro ADMIN, ten dang nhap "qc", mat khau >= 10 ky tu, roi dang nhap mot lan de doi mat khau
#   bat buoc lan dau (e2e khong qua duoc man hinh do).
# Day du 39 bai e2e:  pnpm e2e:all   (xem README muc "Chay bo nghiem thu")
E2E_ADMIN_USER=qc
E2E_ADMIN_PASSWORD=
# Chi pha 0 dung: bai do doi mat khau that, nen no can mot mat khau moi de doi sang.
E2E_ADMIN_NEW_PASSWORD=
# Duong thu hai cho cac bai chi can vung /parent (pha 5). De trong neu da co tai khoan ADMIN test.
E2E_PARENT_USER=
E2E_PARENT_PASSWORD=
# chrome | msedge = dung trinh duyet da cai (khong tai Chromium ve). De trong = Chromium cua Playwright.
E2E_CHANNEL=msedge

# --- Sao luu (pha 8 viec 2) ---
# Thu muc tren may host de chua ban sao luu moi dem. Duong dan Windows deu duoc.
BACKUP_DIR=E:/SAO-LUU-MTCT
# Giu bao nhieu ngay ban sao luu truoc khi xoa ban cu nhat
BACKUP_KEEP_DAYS=30
# Gio chay sao luu moi dem (gio Viet Nam, 0-23)
BACKUP_HOUR=1
# Con trong bao nhieu GB thi trang /admin/health bat canh bao do dia
DISK_WARN_FREE_GB=10

# --- May chu (pha 9): GET /api/health tra ve truong "host" nay de phan biet may nao dang tra loi.
# De trong = dung hostname cua container (mot chuoi ngau nhien, kho doc). Vi du: ubuntu-edison
DEPLOY_HOST=

# --- Web ---
PORT=5000
