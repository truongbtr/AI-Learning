# ===== Hoc cung Mai Thy & Chi Thanh — bien moi truong =====
# Sao chep thanh .env va dien gia tri that. KHONG commit .env.
# Khong co khoa API LLM nao trong he thong (ADR-10).

# --- PostgreSQL (docker/compose.yml tao container "postgres" voi cac gia tri nay) ---
POSTGRES_USER=mtct
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=mtct
# Cong Postgres mo ra may host (doi neu 5432 da co ung dung khac dung)
POSTGRES_PORT=5432
# Ket noi tu may host (pnpm dev, prisma studio). Trong container, compose tu doi host thanh "postgres".
DATABASE_URL=postgresql://mtct:change-me-postgres@localhost:5432/mtct

# --- Auth.js ---
# Tao bang PowerShell:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=change-me-32-bytes-base64
# URL cong khai cua web (qua Cloudflare Tunnel thi doi thanh https://<domain>)
AUTH_URL=http://localhost:5000
AUTH_TRUST_HOST=true

# --- Tai khoan admin tao san (chi seed khi DB chua co ADMIN; bat buoc doi mat khau lan dau) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=ba@example.com
ADMIN_PASSWORD=change-me-strong-password-10+

# --- Nam hoc: ngay bat dau tuan 1 (chu du an chot 12/09/2026; sua lai o /parent/school, docs/11 §5) ---
SCHOOL_YEAR_START=2026-08-24

# --- File & hang cho AI ---
FILE_ROOT=/data/files
INBOX_ROOT=./inbox

# --- TTS (ADR-6, ADR-11 + bo sung Azure): giong DUNG SAN, KHONG nhan ban giong tre ---
# azure     = MAC DINH (bac F0 mien phi ~500k ky tu/thang). Khong co khoa -> Web Speech, app van chay.
# vbee      = tuy chon (nha cung cap Viet Nam). google | webspeech = tuy chon.
TTS_PROVIDER=azure
# Khoa tai nguyen Speech tren Azure. DE TRONG trong file mau nay.
TTS_API_KEY=
# Vbee: App-Id cua ung dung trong bang dieu khien Vbee
TTS_APP_ID=
# Azure: vung cua tai nguyen Speech. Vbee/Google: khong can.
TTS_REGION=eastasia
# De trong = giong da chot (nghe thu 11/09/2026). Liet ke giong that: pnpm tts:voices
# azure  vi: vi-VN-HoaiMyNeural  en: en-US-AnaNeural
# vbee   vi: hn_female_ngochuyen_full_48k-fhg (kiem lai bang pnpm tts:voices)
# google vi: vi-VN-Neural2-A     en: en-US-Neural2-F
TTS_VOICE_VI=
TTS_VOICE_EN=
# CHI ap cho TIENG ANH (SSML <prosody rate>). Tieng Viet doc nguyen toc do goc - da chot, dung them.
# Nghe thu mot cau: pnpm tts:smoke "Nghe roi chon o dung nhe!"
TTS_RATE=-10%

# --- Token noi bo cho worker goi POST /api/evidence (TUY CHON) ---
# De trong: chi tai khoan ADMIN duoc ghi bang chung. Tao: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
INTERNAL_API_TOKEN=

# --- Cloudflare Tunnel (pha 8) ---
TUNNEL_TOKEN=

# --- Web ---
PORT=5000
