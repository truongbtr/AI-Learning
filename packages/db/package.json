{
  "name": "@mtct/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, seed and the shared PrismaClient (built to CommonJS so Next/Node can load it as an external)",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "generated",
    "prisma",
    "package.json"
  ],
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:dev": "cross-env SEED_DEV=1 tsx prisma/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "content:import": "dotenv -e ../../.env -- tsx src/cli/content-import.ts",
    "content:stats": "dotenv -e ../../.env -- tsx src/cli/content-stats.ts",
    "content:export": "dotenv -e ../../.env -- tsx src/cli/content-export.ts",
    "content:import-intake": "dotenv -e ../../.env -- tsx src/cli/content-import-intake.ts",
    "eval:intake": "dotenv -e ../../.env -- tsx src/cli/eval-intake.ts",
    "school-year": "dotenv -e ../../.env -- tsx src/cli/school-year.ts",
    "clean-test-students": "dotenv -e ../../.env -- tsx src/cli/clean-test-students.ts",
    "tts:voices": "dotenv -e ../../.env -- tsx src/cli/tts-voices.ts",
    "tts:smoke": "dotenv -e ../../.env -- tsx src/cli/tts-smoke.ts"
  },
  "dependencies": {
    "@mtct/content": "workspace:*",
    "@mtct/core": "workspace:*",
    "@node-rs/argon2": "^2.0.0",
    "@prisma/client": "^6.19.0",
    "dotenv": "^17.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@mtct/config": "workspace:*",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
