{
  "name": "@mtct/inbox",
  "version": "0.1.0",
  "private": true,
  "description": "AI queue (docs/13): schemas + pull/validate/push CLIs processed by Claude Code in batches. No LLM SDK (ADR-10).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "pull": "dotenv -e ../../.env -- tsx src/cli/pull.ts",
    "validate": "tsx src/cli/validate.ts",
    "push": "dotenv -e ../../.env -- tsx src/cli/push.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.0.0",
    "@mtct/content": "workspace:*",
    "@mtct/core": "workspace:*",
    "@mtct/db": "workspace:*"
  },
  "devDependencies": {
    "@mtct/config": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0",
    "dotenv-cli": "^11.0.0",
    "dotenv": "^17.0.0"
  },
  "files": [
    "src",
    "package.json"
  ]
}
