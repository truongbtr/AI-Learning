{
  "name": "@mtct/content",
  "version": "0.1.0",
  "private": true,
  "description": "Content workshop: Zod schemas, validators, importer and stats for content/ (CLI, not part of the running app)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "validate": "tsx src/cli/validate.ts",
    "import": "tsx src/cli/not-yet.ts import",
    "stats": "tsx src/cli/not-yet.ts stats",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@mtct/config": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "files": [
    "src",
    "package.json"
  ]
}
