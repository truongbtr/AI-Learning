{
  "name": "@mtct/core",
  "version": "0.1.0",
  "private": true,
  "description": "Pure domain logic (no Next, no Prisma): auth policy, calendar, mastery, remediation, storage adapter. TS source for bundlers/tsx, CommonJS dist for @mtct/db",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./storage": {
      "types": "./src/storage/index.ts",
      "require": "./dist/storage/index.js",
      "default": "./dist/storage/index.js"
    },
    "./tts": {
      "types": "./src/tts/index.ts",
      "require": "./dist/tts/index.js",
      "default": "./dist/tts/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@mtct/config": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "files": [
    "src",
    "dist",
    "package.json"
  ]
}
